# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in a key:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Which LLM provider to use: google or openai.
# Leave this alone unless you have a reason — google is the workshop default
# because it has a free tier.
COLLEGE_AGENT_PROVIDER=google

# --- If you're using google (the default) ----------------------------------
#
# Your Gemini API key from https://aistudio.google.com/apikey
# Free, no credit card.
#
# IMPORTANT: the variable is GOOGLE_API_KEY, *not* GEMINI_API_KEY.
# Google's own quickstart tells you to set GEMINI_API_KEY, but Agno's Gemini
# class only ever reads GOOGLE_API_KEY. Set the wrong one and you get a
# confusing "model provider" error instead of "no API key".
GOOGLE_API_KEY=

# --- If you're using openai -------------------------------------------------
#
# Your key from https://platform.openai.com/api-keys
#
# NOTE: OpenAI has NO FREE TIER. This needs paid credits on your account.
# If you're a student without credits, use google above instead.
# Remember to also set COLLEGE_AGENT_PROVIDER=openai.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------

# Agno phones home with anonymous usage telemetry by default.
# Off for the classroom. Flip to true if you'd like to support the project.
AGNO_TELEMETRY=false

# ---------------------------------------------------------------------------
# Optional knobs — the defaults are tuned for the free tier, leave them alone
# unless you know why you're changing them.
# ---------------------------------------------------------------------------

# Override the model. Defaults to the selected provider's cheapest fast model
# (gemini-3.5-flash-lite / gpt-5.4-mini). Module 3 has you swap this to measure
# the accuracy-vs-cost tradeoff rather than taking anyone's word for it.
# COLLEGE_AGENT_MODEL=

# Caches every model response to disk, keyed by request hash. Re-running the
# same prompt while debugging then costs zero quota. Set to false to disable.
# COLLEGE_AGENT_CACHE=true
